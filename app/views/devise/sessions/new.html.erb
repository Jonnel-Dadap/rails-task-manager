<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">TASK<span class="text-3xl font-bold tracking-tigth text-gray-500">ORA</span></h1>
      <p class="mt-2 text-sm text-gray-500">Plan Better. Work Smarter.</p>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8">
      <div class="mb-8">
        <h2 class="text-2xl font-semibold text-gray-900">Welcome back</h2>
        <p class="text-sm text-gray-500 mt-2">Sign in to continue to your account.</p>
        <%= render "devise/shared/error_messages", resource: resource %>
        
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" %>
          </div>

          <div>
            <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
                <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
                Remember me
              </label>
            </div>
          <% end %>

          <div>
            <%= f.submit "Log in", class: "w-full bg-gray-900 hover:bg-black text-white font-medium py-3 rounded-lg text-sm transition duration-200 cursor-pointer" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-gray-500">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path(resource_name), class: "font-semibold text-gray-900 hover:underline" %>
      </div>
    </div>

    <p class="text-center text-xs text-gray-400 mt-8">
      &copy; <%= Date.current.year %> TASKORA. All rights reserved.
    </p>
  </div>
</div>
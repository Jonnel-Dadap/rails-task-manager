<div id="<%= dom_id task %>" class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition duration-200">

  <div class="p-6">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">
        Task Information
      </span>

      <% status_style = case task.status
        when "Pending" then "bg-amber-50 text-amber-700 border-amber-200"
        when "In Progress" then "bg-blue-50 text-blue-700 border-blue-200"
        when "Completed" then "bg-emerald-50 text-emerald-700 border-emerald-200"
        else "bg-gray-50 text-gray-600 border-gray-200"
      end %>

      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-semibold <%= status_style %>">
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <%= task.status %>
      </span>
    </div>

    <!-- Task Title -->
    <div class="mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
        Task Title
      </p>

      <h3 class="text-xl font-bold text-gray-900 leading-snug">
        <%= task.title %>
      </h3>
    </div>

    <!-- Description -->
    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
        Description
      </p>

      <p class="text-sm text-gray-600 leading-7">
        <%= task.description.presence || "No description provided." %>
      </p>
    </div>

  </div>

  <div class="h-1 bg-gray-50"></div>

</div>
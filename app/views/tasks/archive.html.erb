<div class="min-h-screen bg-white px-5 py-10 sm:px-8">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">
        Personal Workspace
      </p>
      <h1 class="text-3xl font-bold text-gray-900">Archived Tasks</h1>
      <p class="text-sm text-gray-500 mt-2">
        Review and manage your previously archived tasks.
      </p>
    </div>

    <!-- Notice -->
    <% if notice.present? %>
      <div class="mb-6 p-4 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-700">
        <%= notice %>
      </div>
    <% end %>

    <% if @tasks.any? %>
      <div class="space-y-4">
        <% @tasks.each do |task| %>
          <div class="bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition">

            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-5">

              <!-- Task Information -->
              <div class="flex-1 min-w-0">

                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">
                  Task Title
                </p>

                <h2 class="text-lg font-semibold text-gray-900 mb-4">
                  <%= task.title %>
                </h2>

                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">
                  Description
                </p>

                <p class="text-sm text-gray-600 leading-6">
                  <%= task.description.presence || "No description provided." %>
                </p>

                <!-- Dates -->
                <div class="flex flex-wrap gap-x-6 gap-y-3 mt-6 pt-4 border-t border-gray-100">

                  <div>
                    <p class="text-xs text-gray-400 font-medium mb-1">Created</p>
                    <p class="text-sm text-gray-700 font-medium">
                      <%= task.created_at.strftime("%b %d, %Y · %I:%M %p") %>
                    </p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-400 font-medium mb-1">Last Updated</p>
                    <p class="text-sm text-gray-700 font-medium">
                      <%= task.updated_at.strftime("%b %d, %Y · %I:%M %p") %>
                    </p>
                  </div>

                </div>

              </div>

              <!-- Actions -->
              <div class="shrink-0 flex flex-row gap-2">

      <%= button_to "Restore",
                restore_task_path(task),
                method: :patch,
                class: "px-4 py-2 text-sm font-semibold text-blue-900 bg-blue-50 border border-blue-100 rounded-lg hover:bg-blue-100 transition cursor-pointer" %>

     <%= button_to task,
      method: :delete,
      title: "Delete Task",
      class: "p-2.5 text-red-700 bg-red-50 border border-red-100 rounded-lg hover:bg-red-100 transition cursor-pointer" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
    </svg>
  <% end %>
</div>
            </div>

          </div>
        <% end %>
      </div>

    <% else %>

      <div class="border border-dashed border-gray-300 rounded-xl py-16 px-6 text-center">
        <h2 class="text-lg font-semibold text-gray-800 mb-2">
          No Archived Tasks
        </h2>
        <p class="text-sm text-gray-500">
          Tasks you archive will appear here.
        </p>
      </div>

    <% end %>

  </div>
</div>
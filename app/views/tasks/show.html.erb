<% content_for :title, "Task Details" %>

<div class="min-h-screen bg-white px-5 py-12 sm:px-8">
  <div class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-xs text-gray-500 font-semibold uppercase tracking-widest">
        Personal Workspace
      </p>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3">
        Task Details
      </h1>

      <p class="text-gray-500 mt-2">
        View and manage your task information.
      </p>
    </div>

    <!-- Validation Errors -->
    <% if @task.errors.any? %>
      <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-sm text-red-700">
        <%= @task.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <!-- Notice -->
    <% if notice.present? %>
      <div class="mb-6 p-4 rounded-lg border border-green-200 bg-green-50 text-sm text-green-700">
        <%= notice %>
      </div>
    <% end %>

    <!-- Task Card -->
    <div class="border border-gray-200 rounded-xl p-6 sm:p-8 shadow-sm">
      <%= render @task %>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 mt-6">

      <%= link_to "Edit Task",
          edit_task_path(@task),
          class: "px-6 py-3 bg-black text-white text-sm font-medium rounded-lg text-center hover:bg-gray-800 transition" %>

      <% if @task.status == "Completed" && !@task.archived? %>
        <%= button_to "Archive Task",
            archive_task_path(@task),
            method: :patch,
            class: "px-6 py-3 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg text-center hover:bg-gray-100 transition cursor-pointer" %>
      <% end %>

      <%= link_to "Back to Tasks",
          tasks_path,
          class: "px-6 py-3 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg text-center hover:bg-gray-100 transition" %>

      <%= button_to "Delete Task",
          @task,
          method: :delete,
          class: "px-6 py-3 border border-red-200 text-red-600 text-sm font-medium rounded-lg hover:bg-red-50 transition cursor-pointer",
          form_class: "sm:ml-auto" %>

    </div>

  </div>
</div>
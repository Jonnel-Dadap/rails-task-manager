<%= form_with(model: task) do |form| %>

  <% if task.errors.any? %>
    <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-red-700">
      <h2 class="font-semibold text-sm mb-2">
        <%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:
      </h2>

      <ul class="list-disc pl-5 text-sm space-y-1">
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">

    <!-- Title -->
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-2" %>

      <%= form.text_field :title,
          placeholder: "Enter task title",
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-gray-500 transition" %>
    </div>

    <!-- Description -->
    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-2" %>

      <%= form.textarea :description,
          rows: 4,
          placeholder: "Add a description for your task...",
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-gray-500 transition resize-y" %>
    </div>

    <!-- Status -->
    <% if task.persisted? %>
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= form.select :status,
            ["Pending", "In Progress", "Completed"],
            {},
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-gray-500 transition cursor-pointer" %>
      </div>
    <% end %>

    <!-- Submit -->
    <div class="pt-3">
      <%= form.submit task.persisted? ? "Update Task" : "Create Task",
          class: "w-full px-6 py-3 bg-black text-white text-sm font-medium rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition cursor-pointer" %>
    </div>

  </div>

<% end %>
<% content_for :title, "New Task" %>

<div class="min-h-screen bg-white px-5 py-12 sm:px-8 flex items-center justify-center">
  <div class="w-full max-w-xl">

    <div class="mb-7 text-center">
      <p class="text-xs text-gray-500 font-semibold uppercase tracking-widest">
        Personal Workspace
      </p>

      <h1 class="text-3xl font-bold tracking-tight mt-3">
        Create New Task
      </h1>

      <p class="text-sm text-gray-500 mt-2">
        Add a task and stay organized.
      </p>
    </div>

    <div class="border border-gray-200 rounded-xl p-6 sm:p-8 shadow-sm bg-white">

      <%= render "form", task: @task %>

    </div>

    <div class="mt-5 text-center">
      <%= link_to "← Back to Tasks", tasks_path,
          class: "text-sm text-gray-500 hover:text-black transition" %>
    </div>

  </div>
</div>
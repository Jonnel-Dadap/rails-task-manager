
<section class="px-6 py-24 sm:py-32">
  <div class="max-w-5xl mx-auto text-center">
  <%= image_tag "taskora.svg",
    alt: "Taskora Logo",
    style: "width: 200px; height: 200px; max-width: 100%; object-fit: contain;",
    class: "mx-auto mb-2" %>

    <p class="text-sm font-medium text-gray-500 uppercase tracking-widest">
      Personal Task Management
    </p>

    <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mt-6">
      Plan Better.
      <span class="text-gray-400">Work Smarter.</span>
    </h2>

    <p class="max-w-2xl mx-auto mt-6 text-base sm:text-lg text-gray-500 leading-relaxed">
      Keep your tasks organized, set priorities, track deadlines,
      and manage your daily activities in one place.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
     <a href="/tasks"
   class="px-7 py-3 bg-gradient-to-r from-[#080808] via-[#333333] to-[#1a1919] text-white rounded-lg font-medium border border-[#555555] hover:brightness-110 transition">
  Get Started
</a>

      <a href="#features"
         class="px-7 py-3 border border-gray-300 rounded-lg font-medium hover:bg-gray-100 transition">
        Explore Features
      </a>
    </div>

  </div>
</section>

<section id="features" class="bg-gray-50 px-6 py-20">
  <div class="max-w-6xl mx-auto">

    <div class="text-center max-w-2xl mx-auto">
      <p class="text-sm font-semibold text-blue-900 uppercase tracking-widest mb-3">
        Features
      </p>

      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        Everything in One Place
      </h2>

      <p class="mt-4 text-gray-500 leading-relaxed">
        Simple and practical tools designed to help you organize tasks and manage your daily workload.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">

      <!-- Task Management -->
      <div class="bg-white border border-gray-200 rounded-xl p-8 hover:border-blue-200 hover:shadow-sm transition duration-200">
        <div class="w-11 h-11 flex items-center justify-center rounded-lg bg-blue-50 text-blue-900 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5h6m-7 4h8m-8 4h5m-7-9h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/>
          </svg>
        </div>

        <h3 class="text-lg font-semibold text-gray-900">
          Task Management
        </h3>

        <p class="text-sm text-gray-500 mt-3 leading-relaxed">
          Create, update, and manage your personal tasks in one organized workspace.
        </p>
      </div>

      <!-- Task Organization -->
      <div class="bg-white border border-gray-200 rounded-xl p-8 hover:border-blue-200 hover:shadow-sm transition duration-200">
        <div class="w-11 h-11 flex items-center justify-center rounded-lg bg-blue-50 text-blue-900 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 6v.01M8 12v.01M8 18v.01"/>
          </svg>
        </div>

        <h3 class="text-lg font-semibold text-gray-900">
          Task Organization
        </h3>

        <p class="text-sm text-gray-500 mt-3 leading-relaxed">
          Organize and monitor your tasks through their current status, from pending to completed.
        </p>
      </div>

      <!-- Archive Management -->
      <div class="bg-white border border-gray-200 rounded-xl p-8 hover:border-blue-200 hover:shadow-sm transition duration-200">
        <div class="w-11 h-11 flex items-center justify-center rounded-lg bg-blue-50 text-blue-900 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18v4H3z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 9v10h14V9M10 13h4"/>
          </svg>
        </div>

        <h3 class="text-lg font-semibold text-gray-900">
          Archive Management
        </h3>

        <p class="text-sm text-gray-500 mt-3 leading-relaxed">
          Keep your active workspace clean by archiving tasks and restoring them whenever needed.
        </p>
      </div>

    </div>
  </div>
</section>


<section class="px-6 py-24 sm:py-32">
  <div class="max-w-5xl mx-auto text-center">
  <%= image_tag "taskora.svg",
    alt: "Taskora Logo",
    style: "width: 200px; height: 200px; max-width: 100%; object-fit: contain;",
    class: "mx-auto mb-2" %>

    <p class="text-sm font-medium text-gray-500 uppercase tracking-widest">
      Personal Task Management
    </p>

    <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mt-6">
      Plan Better.
      <span class="text-gray-400">Work Smarter.</span>
    </h2>

    <p class="max-w-2xl mx-auto mt-6 text-base sm:text-lg text-gray-500 leading-relaxed">
      Keep your tasks organized, set priorities, track deadlines,
      and manage your daily activities in one place.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
     <a href="/tasks"
   class="px-7 py-3 bg-gradient-to-r from-[#080808] via-[#333333] to-[#1a1919] text-white rounded-lg font-medium border border-[#555555] hover:brightness-110 transition">
  Get Started
</a>

      <a href="#features"
         class="px-7 py-3 border border-gray-300 rounded-lg font-medium hover:bg-gray-100 transition">
        Explore Features
      </a>
    </div>

  </div>
</section>

<section id="features" class="bg-gray-50 px-6 py-20">
  <div class="max-w-6xl mx-auto">

    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">
        Everything in One Place
      </h2>

      <p class="mt-4 text-gray-500">
        Simple tools to help you manage your tasks and stay on track.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">

      <div class="bg-white border border-gray-200 rounded-xl p-8">
        <h3 class="text-xl font-semibold">Task Management</h3>
        <p class="text-gray-500 mt-3 leading-relaxed">
          Create, update, and manage your personal tasks in one place.
        </p>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-8">
        <h3 class="text-xl font-semibold">Priority and Deadlines</h3>
        <p class="text-gray-500 mt-3 leading-relaxed">
          Set task priorities and due dates to keep your work organized.
        </p>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-8">
        <h3 class="text-xl font-semibold">Progress Tracking</h3>
        <p class="text-gray-500 mt-3 leading-relaxed">
          Track pending, ongoing, completed, and overdue tasks through your dashboard.
        </p>
      </div>

    </div>
  </div>
</section>
